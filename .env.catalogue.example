# Leave unset for public/data/organizations.json.
# To use a backend, copy this file to .env.local, uncomment the line, and restart Vite.
# This endpoint must return the full dataset in one of the documented JSON shapes.
# VITE_ORGANIZATIONS_URL=http://localhost:8000/api/organizations

# VITE_* values are PUBLIC in the browser bundle. Never put API secrets here.
